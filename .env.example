GROQ_API_KEY=
GEMINI_API_KEY=
CLIENT_KEYS=android:CHANGE_ME,web:CHANGE_ME
CORS_ORIGINS=
MAX_UPLOAD_MB=15
CORRECTION_ENABLED=true
LOCAL_WHISPER_ENABLED=false
LOG_LEVEL=INFO
DAILY_REQUEST_LIMIT=2000

# Host port the gateway is published on (container always listens on 8080).
STT_GATEWAY_PORT=8090

# Provider models — change these to upgrade without touching code.
GROQ_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-2.5-flash-lite
